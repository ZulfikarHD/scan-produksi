## 6. Contoh Lengkap Controller

```php
<?php

namespace App\Http\Controllers;

use App\Models\ProductionBatch;
use Illuminate\Http\Request;

class ProductionBatchController extends Controller
{
    /**
     * Tampilkan halaman utama monitoring batch produksi.
     */
    public function index(Request $request)
    {
        // Filter batch berdasarkan status aktif dan tanggal hari ini
        $query = ProductionBatch::query()
            ->with(['machine', 'operator'])
            ->latest();

        if ($request->filled('machine_id')) {
            $query->where('machine_id', $request->machine_id);
        }

        $batches = $query->paginate(15);

        return view('production.batches.index', compact('batches'));
    }

    /**
     * Simpan batch baru dari form input operator.
     */
    public function store(Request $request)
    {
        $validated = $request->validate([
            'po_number' => ['required', 'string'],
            'machine_id' => ['required', 'exists:machines,id'],
            'target_sheets' => ['required', 'integer', 'min:1'],
        ]);

        // Hitung estimasi waktu cetak berdasarkan kecepatan standar mesin (lembar/jam)
        $standardSpeed = 5000;
        $estimatedHours = ceil($validated['target_sheets'] / $standardSpeed);

        $batch = ProductionBatch::create([
            ...$validated,
            'status' => 'pending',
            'estimated_hours' => $estimatedHours,
        ]);

        return redirect()
            ->route('production.batches.index')
            ->with('success', 'Batch produksi berhasil dibuat.');
    }

    /**
     * Hapus batch jika belum masuk status proses cetak.
     */
    public function destroy(ProductionBatch $batch)
    {
        if ($batch->status === 'in_progress') {
            return back()->with('error', 'Batch yang sedang berjalan tidak dapat dihapus.');
        }

        $batch->delete();

        return redirect()
            ->route('production.batches.index')
            ->with('success', 'Batch produksi berhasil dihapus.');
    }
}
```

